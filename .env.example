NODE_ENV=development
PORT=3005
LOG_LEVEL=debug
LOG_SERVICE_NAME=tracking-service

# MongoDB (dev compose brings this up on :27018).
TRACKING_MONGO_URL=mongodb://localhost:27018/tracking

# Redis (dev compose on :6380 / platform logistics-redis). Socket.IO adapter pub/sub.
REDIS_URL=redis://localhost:6380

# Broker. Platform `logistics-rabbitmq` uses dev/dev.
RABBITMQ_URL=amqp://dev:dev@localhost:5672

# Verifies INBOUND user JWTs (HS256). MUST EQUAL auth-service's AUTH_JWT_SECRET.
JWT_SECRET=change-me-min-32-chars-aaaaaaaaaaaa

# Location point retention (days). TTL on the time-series collection.
TRACKING_LOCATION_TTL_DAYS=30
